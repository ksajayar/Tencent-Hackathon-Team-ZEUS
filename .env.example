# Channel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Own number, connected to a Meta Business Account - not the shared sandbox.
TWILIO_WHATSAPP_FROM=whatsapp:+13158126378
# Approved "Appointment reminder" template ContentSid (starts HX) - look it up
# via GET /internal/debug/templates once deployed. Optional; reminders outside
# the 24h window just log and skip until this is set.
TWILIO_APPOINTMENT_TEMPLATE_SID=
# Optional: seeds one is_emergency=true contact for the SOS demo (E.164,
# e.g. +6591234567 - must have messaged this number within the last 24h to
# receive a free-form send; otherwise a template is required).
DEMO_EMERGENCY_CONTACT_PHONE=

# AI
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_MAIN=gemini-flash-latest

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<app>.up.railway.app/oauth/google/callback

# Data
DATABASE_URL=postgresql+asyncpg://postgres:dev@db:5432/dementia
MEDIA_ROOT=/data/media
TTS_CACHE_ROOT=/data/tts

# Crypto
TOKEN_ENCRYPTION_KEY=
MEDIA_SIGNING_KEY=
ADMIN_TOKEN=

# App
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_TIMEZONE=Asia/Singapore
LOG_LEVEL=INFO
ENVIRONMENT=development
